{
  "description": "Block edits to generated output before they happen (llm-08).",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/block-generated-edit.mjs"
          }
        ]
      }
    ]
  }
}
